+func (h *Inbound) ListUsers(ctx context.Context) []any {
+	h.usersAccess.RLock()
+	defer h.usersAccess.RUnlock()
+	users := make([]any, len(h.users))
+	for index, user := range h.users {
+		users[index] = user
+	}
+	return users
+}
+
+func (h *Inbound) AddUser(ctx context.Context, rawUser any) error {
+	user, ok := rawUser.(option.VMessUser)
+	if !ok {
+		return E.New("invalid VMess user")
+	}
+	if user.Name == "" {
+		return E.New("user name is required for runtime user management")
+	}
+	if user.UUID == "" {
+		return E.New("user uuid is required")
+	}
+	if user.AlterId > 0 {
+		return E.New("runtime VMess user update with alterId > 0 is not supported")
+	}
+
+	h.serviceAccess.Lock()
+	defer h.serviceAccess.Unlock()
+	h.usersAccess.Lock()
+	defer h.usersAccess.Unlock()
+	for _, existingUser := range h.users {
+		if existingUser.AlterId > 0 {
+			return E.New("runtime VMess user update with alterId > 0 is not supported")
+		}
+		if strings.EqualFold(existingUser.Name, user.Name) {
+			return E.New("user ", user.Name, " already exists")
+		}
+		if strings.EqualFold(existingUser.UUID, user.UUID) {
+			return E.New("uuid already exists")
+		}
+	}
+	newUsers := append(append([]option.VMessUser(nil), h.users...), user)
+	if err := updateVMessUsers(h.service, newUsers); err != nil {
+		return err
+	}
+	h.users = newUsers
+	return nil
+}
+
+func (h *Inbound) RemoveUser(ctx context.Context, name string) error {
+	if name == "" {
+		return E.New("user name is required")
+	}
+
+	h.serviceAccess.Lock()
+	defer h.serviceAccess.Unlock()
+	h.usersAccess.Lock()
+	defer h.usersAccess.Unlock()
+	for _, existingUser := range h.users {
+		if existingUser.AlterId > 0 {
+			return E.New("runtime VMess user update with alterId > 0 is not supported")
+		}
+	}
+	newUsers := make([]option.VMessUser, 0, len(h.users))
+	found := false
+	for _, user := range h.users {
+		if strings.EqualFold(user.Name, name) {
+			found = true
+			continue
+		}
+		newUsers = append(newUsers, user)
+	}
+	if !found {
+		return E.New("user ", name, " not found")
+	}
+	if err := updateVMessUsers(h.service, newUsers); err != nil {
+		return err
+	}
+	h.users = newUsers
+	return nil
+}
