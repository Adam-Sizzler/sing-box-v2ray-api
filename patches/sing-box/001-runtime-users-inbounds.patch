+func (h *Inbound) ListUsers(ctx context.Context) []any {
+	h.usersAccess.RLock()
+	defer h.usersAccess.RUnlock()
+	users := make([]any, len(h.users))
+	for index, user := range h.users {
+		users[index] = user
+	}
+	return users
+}
+
+func (h *Inbound) AddUser(ctx context.Context, rawUser any) error {
+	user, ok := rawUser.(option.TrojanUser)
+	if !ok {
+		return E.New("invalid Trojan user")
+	}
+	if user.Name == "" {
+		return E.New("user name is required for runtime user management")
+	}
+	if user.Password == "" {
+		return E.New("user password is required")
+	}
+
+	h.serviceAccess.Lock()
+	defer h.serviceAccess.Unlock()
+	h.usersAccess.Lock()
+	defer h.usersAccess.Unlock()
+	for _, existingUser := range h.users {
+		if strings.EqualFold(existingUser.Name, user.Name) {
+			return E.New("user ", user.Name, " already exists")
+		}
+		if existingUser.Password == user.Password {
+			return E.New("password already exists")
+		}
+	}
+	newUsers := append(append([]option.TrojanUser(nil), h.users...), user)
+	if err := updateTrojanUsers(h.service, newUsers); err != nil {
+		return err
+	}
+	h.users = newUsers
+	return nil
+}
+
+func (h *Inbound) RemoveUser(ctx context.Context, name string) error {
+	if name == "" {
+		return E.New("user name is required")
+	}
+
+	h.serviceAccess.Lock()
+	defer h.serviceAccess.Unlock()
+	h.usersAccess.Lock()
+	defer h.usersAccess.Unlock()
+	newUsers := make([]option.TrojanUser, 0, len(h.users))
+	found := false
+	for _, user := range h.users {
+		if strings.EqualFold(user.Name, name) {
+			found = true
+			continue
+		}
+		newUsers = append(newUsers, user)
+	}
+	if !found {
+		return E.New("user ", name, " not found")
+	}
+	if err := updateTrojanUsers(h.service, newUsers); err != nil {
+		return err
+	}
+	h.users = newUsers
+	return nil
+}
