@@ -0,0 +1,214 @@
+package clashapi
+
+import (
+	"io"
+	"net/http"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	F "github.com/sagernet/sing/common/format"
+	"github.com/sagernet/sing/common/json"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/go-chi/render"
+)
+
+func inboundRouter(s *Server) http.Handler {
+	r := chi.NewRouter()
+	r.Get("/", s.listInbounds)
+	r.Post("/", s.addInbound)
+	r.Delete("/{tag}", s.removeInbound)
+	r.Get("/{tag}/users", s.listInboundUsers)
+	r.Post("/{tag}/users", s.addInboundUser)
+	r.Delete("/{tag}/users/{name}", s.removeInboundUser)
+	return r
+}
+
+func (s *Server) listInbounds(writer http.ResponseWriter, request *http.Request) {
+	if s.inbound == nil {
+		render.Status(request, http.StatusInternalServerError)
+		render.PlainText(writer, request, "inbound manager not available")
+		return
+	}
+	inbounds := s.inbound.Inbounds()
+	items := make([]render.M, 0, len(inbounds))
+	for _, inbound := range inbounds {
+		items = append(items, render.M{
+			"tag":  inbound.Tag(),
+			"type": inbound.Type(),
+		})
+	}
+	render.JSON(writer, request, render.M{
+		"inbounds": items,
+	})
+}
+
+func (s *Server) addInbound(writer http.ResponseWriter, request *http.Request) {
+	if s.inbound == nil {
+		render.Status(request, http.StatusInternalServerError)
+		render.PlainText(writer, request, "inbound manager not available")
+		return
+	}
+	if s.router == nil {
+		render.Status(request, http.StatusInternalServerError)
+		render.PlainText(writer, request, "router not available")
+		return
+	}
+	if s.logFactory == nil {
+		render.Status(request, http.StatusInternalServerError)
+		render.PlainText(writer, request, "log factory not available")
+		return
+	}
+
+	content, err := io.ReadAll(request.Body)
+	if err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	var inboundOptions option.Inbound
+	err = json.UnmarshalContext(s.ctx, content, &inboundOptions)
+	if err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	if inboundOptions.Type == "" {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, "inbound type is required")
+		return
+	}
+	if inboundOptions.Tag == "" {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, "inbound tag is required for runtime inbound management")
+		return
+	}
+	if _, loaded := s.inbound.Get(inboundOptions.Tag); loaded {
+		render.Status(request, http.StatusConflict)
+		render.PlainText(writer, request, F.ToString("inbound ", inboundOptions.Tag, " already exists"))
+		return
+	}
+
+	err = s.inbound.Create(
+		s.ctx,
+		s.router,
+		s.logFactory.NewLogger(F.ToString("inbound/", inboundOptions.Type, "[", inboundOptions.Tag, "]")),
+		inboundOptions.Tag,
+		inboundOptions.Type,
+		inboundOptions.Options,
+	)
+	if err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	writer.WriteHeader(http.StatusCreated)
+}
+
+func (s *Server) removeInbound(writer http.ResponseWriter, request *http.Request) {
+	if s.inbound == nil {
+		render.Status(request, http.StatusInternalServerError)
+		render.PlainText(writer, request, "inbound manager not available")
+		return
+	}
+	tag := getEscapeParam(request, "tag")
+	if tag == "" {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, "inbound tag is required")
+		return
+	}
+	if err := s.inbound.Remove(tag); err != nil {
+		render.Status(request, http.StatusNotFound)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	writer.WriteHeader(http.StatusNoContent)
+}
+
+func (s *Server) runtimeUserInbound(request *http.Request) (adapter.RuntimeUserInbound, error) {
+	if s.inbound == nil {
+		return nil, E.New("inbound manager not available")
+	}
+	tag := getEscapeParam(request, "tag")
+	inbound, loaded := s.inbound.Get(tag)
+	if !loaded {
+		return nil, E.New("inbound ", tag, " not found")
+	}
+	userInbound, loaded := inbound.(adapter.RuntimeUserInbound)
+	if !loaded {
+		return nil, E.New("inbound ", tag, " does not support runtime user management")
+	}
+	return userInbound, nil
+}
+
+func (s *Server) listInboundUsers(writer http.ResponseWriter, request *http.Request) {
+	inbound, err := s.runtimeUserInbound(request)
+	if err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	render.JSON(writer, request, render.M{
+		"users": inbound.ListUsers(request.Context()),
+	})
+}
+
+func (s *Server) addInboundUser(writer http.ResponseWriter, request *http.Request) {
+	inbound, err := s.runtimeUserInbound(request)
+	if err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+
+	var user any
+	switch inbound.Type() {
+	case C.TypeVLESS:
+		var typedUser option.VLESSUser
+		if err = render.DecodeJSON(request.Body, &typedUser); err == nil {
+			user = typedUser
+		}
+	case C.TypeVMess:
+		var typedUser option.VMessUser
+		if err = render.DecodeJSON(request.Body, &typedUser); err == nil {
+			user = typedUser
+		}
+	case C.TypeTrojan:
+		var typedUser option.TrojanUser
+		if err = render.DecodeJSON(request.Body, &typedUser); err == nil {
+			user = typedUser
+		}
+	default:
+		err = E.New("unsupported inbound type: ", inbound.Type())
+	}
+	if err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+
+	if err = inbound.AddUser(request.Context(), user); err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	writer.WriteHeader(http.StatusCreated)
+}
+
+func (s *Server) removeInboundUser(writer http.ResponseWriter, request *http.Request) {
+	inbound, err := s.runtimeUserInbound(request)
+	if err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	name := getEscapeParam(request, "name")
+	if err = inbound.RemoveUser(request.Context(), name); err != nil {
+		render.Status(request, http.StatusBadRequest)
+		render.PlainText(writer, request, err.Error())
+		return
+	}
+	writer.WriteHeader(http.StatusNoContent)
+}
