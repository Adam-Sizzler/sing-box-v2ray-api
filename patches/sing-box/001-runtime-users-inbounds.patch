+func (h *Inbound) userName(index int) string {
+	h.usersAccess.RLock()
+	defer h.usersAccess.RUnlock()
+	if index < 0 || index >= len(h.users) || h.users[index].Name == "" {
+		return F.ToString(index)
+	}
+	return h.users[index].Name
+}
